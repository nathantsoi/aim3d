{
  "$schema": "https://schema.tauri.app/2.0.0/tauri.conf.json",
  "productName": "aim3d",
  "version": "0.1.0",
  "identifier": "com.aim3d.dev",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "cd frontend && npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "aim3d - High-Performance CAD/CAM",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "targets": ["app"],
    "icon": [
      "icons/32x32.png"
    ]
  }
}
